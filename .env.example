# Required for AI-generated plans (get one at https://aistudio.google.com/apikey)
GEMINI_API_KEY=
# Optional: model name
GEMINI_MODEL=gemini-flash-latest
# Optional: comma-separated models tried in order if the primary is overloaded (503/429)
GEMINI_FALLBACK_MODELS=gemini-3.5-flash,gemini-flash-lite-latest
# Optional: enables Google Air Quality API (falls back to Open-Meteo if empty)
GOOGLE_MAPS_API_KEY=
PORT=8080
